# =========================================================================
# XBS Labs Infrastructure Environment Template (.env.example)
# Copy this file to .env and fill in your actual values before running docker-compose
# =========================================================================

# =========================================================================
# 1. LOCAL DEVELOPMENT SETTINGS (docker-compose.yml)
# =========================================================================
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=super_secret_admin_password

AUTH_DB_NAME=naqashly_auth_db
FINANCE_DB_NAME=naqashly_finance_db
PRODUCTIVITY_DB_NAME=naqashly_productivity_db

# =========================================================================
# 2. PRODUCTION CLOUD SETTINGS (Supabase & Upstash)
# =========================================================================
# Supabase PostgreSQL Database
SUPABASE_DB_HOST=db.your-supabase-id.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_postgres_password

# Upstash Serverless Redis
UPSTASH_REDIS_HOST=your-upstash-redis.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your_upstash_redis_password

# Upstash Serverless Kafka
UPSTASH_KAFKA_BOOTSTRAP_SERVERS=your-upstash-kafka.upstash.io:9092
UPSTASH_KAFKA_USERNAME=your_upstash_kafka_username
UPSTASH_KAFKA_PASSWORD=your_upstash_kafka_password

# =========================================================================
# 3. COMMON OAUTH2 & SECURITY SECRETS
# =========================================================================
JWT_SECRET=your_high_entropy_jwt_secret_key_base64
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# =========================================================================
# 4. GRAFANA CLOUD LOKI LOG SHIPPING
# =========================================================================
GRAFANA_LOKI_URL=grafana_loki_url
GRAFANA_LOKI_USER=graffana_user
GRAFANA_LOKI_API_KEY=your_grafana_cloud_api_key_here



