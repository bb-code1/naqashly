# =========================================================================
# XBS Labs Infrastructure Environment Template (.env.example)
# Copy this file to .env and fill in your actual values before running docker-compose
# =========================================================================

# PostgreSQL Root Credentials
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_this_admin_password_123

# Auth Microservice Credentials
AUTH_DB_NAME=naqashly_auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_this_auth_db_password_123

# Finance Microservice Credentials
FINANCE_DB_NAME=naqashly_finance_db
FINANCE_DB_USER=finance_user
FINANCE_DB_PASSWORD=change_this_finance_db_password_123

# Productivity Microservice Credentials
PRODUCTIVITY_DB_NAME=naqashly_productivity_db
PRODUCTIVITY_DB_USER=productivity_user
PRODUCTIVITY_DB_PASSWORD=change_this_productivity_db_password_123

# OAuth2 & JWT Secrets
JWT_PRIVATE_KEY_PATH=/secrets/rsa_private.pem
JWT_PUBLIC_KEY_PATH=/secrets/rsa_public.pem
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
