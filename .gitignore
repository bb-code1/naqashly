# =========================================================================
# XBS Labs Root GitIgnore Specification (Git Security & Secrets Protection)
# =========================================================================

# 1. Environment & Secret Files (NEVER COMMIT REAL SECRETS)
.env
.env.local
.env.*.local
*.env
application-local.yml
application-secrets.yml
application-prod.yml
*.pem
*.key
*.p12
*.jks

# 2. Build Outputs & Package Distributions
build/
out/
target/
dist/
*.jar
*.war
*.ear
*.zip
*.tar.gz

# 3. Gradle Cache & Logs
.gradle/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# 4. Node.js & Vite Exclusions
node_modules/
.npm
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. IDE & Editor Specific Files
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.element
.project
.classpath
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln

# 6. OS & System Junk Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 7. Local Engineering Reports & Architecture Logs (Do Not Push to Public Git)
reports/

